# Shark Audio requires no environment variables for core local use.
# All settings below are optional; uncomment only those you need.
# This file is NOT loaded automatically. See README.md for shell-loading steps.
# Keep real credentials in your ignored .env, never in this example.

# Optional AI script writing: OpenRouter is preferred when a key is available.
# OPENROUTER_API_KEY=''
# OPENAI_API_KEY=''             # Also used by --engine openai for paid speech.
# NATURALVOICE_LLM_MODEL='openai/gpt-4o-mini'

# Custom OpenAI-compatible script-writing server.
# OpenRouter keys (environment or saved in the UI) and OPENAI_API_KEY take priority.
# NATURALVOICE_LLM_URL='http://127.0.0.1:1234/v1'
# NATURALVOICE_LLM_KEY=''       # Omit for servers without authentication.
# Set NATURALVOICE_LLM_MODEL above to a model supported by your server.

# Optional paid speech engine (--engine elevenlabs).
# ELEVENLABS_API_KEY=''

# Optional absolute paths. Defaults are project-local models/, data/,
# and engines/chatterbox/. Leave unset to keep those defaults.
# NATURALVOICE_MODELS='/absolute/path/to/models'
# NATURALVOICE_DATA='/absolute/path/to/data'
# NATURALVOICE_CLONE_ENGINE='/absolute/path/to/engines/chatterbox'

# Optional cloning worker settings (defaults shown).
# NATURALVOICE_CLONE_IDLE=600   # Seconds before unloading an idle worker.
# NATURALVOICE_CLONE_THREADS=2  # ONNX intra-operation threads.
# CHATTERBOX_MODELS='/absolute/path/to/engines/chatterbox/models'
